// The website, baocode.dev: site/ as the Worker `baocode`'s static assets,
// deployed by Cloudflare Workers Builds on a push to main (a preview
// version on any other branch). docs/release.md, 3 and 7.1.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baocode",
	"compatibility_date": "2026-10-06",
	// Only for /dl/*, the latest release's downloads (site-worker/index.js).
	"main": "site-worker/index.js",
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		"run_worker_first": ["/dl/*"]
	},
	"routes": [
		{
			"pattern": "baocode.dev",
			"custom_domain": true
		}
	],
	// Only at baocode.dev: not at baocode.<account>.workers.dev. A branch's
	// preview version keeps its own address there.
	"workers_dev": false,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
